  "faq": {
    "badge": "FAQ",
    "title": "Have a Question?",
    "description": "Answers to the most common questions about the platform and courses",
    "items": {
      "faq-1": {
        "question": "How can I enroll in a course?",
        "answer": "After creating an account on the platform, you can browse the available courses and click the \"Subscribe\" button for the course you want, then follow the payment steps if applicable."
      },
      "faq-2": {
        "question": "Are the courses recorded or live?",
        "answer": "We offer a mix of recorded courses you can watch anytime, and live courses held according to a set schedule."
      },
      "faq-3": {
        "question": "Do I get a certificate after completing the course?",
        "answer": "Yes, after completing all course requirements and passing the assessments, you'll receive a certified completion certificate that can be downloaded and shared."
      },
      "faq-4": {
        "question": "What payment methods are available?",
        "answer": "We accept payment via credit cards (Visa/Mastercard), PayPal, and local bank transfer."
      },
      "faq-5": {
        "question": "Can I get a refund?",
        "answer": "Yes, we offer a refund policy within the first 10 days of enrollment if you're not satisfied with the content."
      }
    }
  },
